{
  "name": "consultin-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "cap": "cap",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "cap:build:android": "npm run build && cap sync android && cap open android",
    "cap:build:ios": "npm run build && cap sync ios && cap open ios",
    "mobile:dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:core",
    "test:core": "vitest run src/__tests__/*.test.ts src/__tests__/use*.test.tsx",
    "test:pages": "vitest run src/__tests__/*.test.tsx --exclude=src/__tests__/flow-*.test.tsx --exclude=src/__tests__/use*.test.tsx --maxWorkers=50% --testTimeout=10000",
    "test:fast": "npm run test:core",
    "test:funnel": "vitest run src/__tests__/flow-funnel.test.tsx --maxWorkers=1 --testTimeout=15000",
    "test:flow": "vitest run src/__tests__/flow-*.test.tsx --maxWorkers=1 --testTimeout=15000",
    "test:full": "vitest run --maxWorkers=50% --testTimeout=10000",
    "test:related": "vitest related",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^8.4.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@pvsmartinez/shared": "^0.6.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.90.21",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "cep-promise": "^4.4.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "react": "^19.0.0",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.2",
    "react-imask": "^7.6.1",
    "react-router-dom": "^7.2.0",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.3",
    "rollup-plugin-visualizer": "^6.0.11",
    "supabase": "^2.76.15",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
